{
  "schema": "literate-ai/release-policy@2",
  "version_scheme": "semver",
  "version_authority": {
    "path": "literate.project.json",
    "format": "json-pointer",
    "selectors": [
      "/version"
    ]
  },
  "version_mirrors": [],
  "contributions": {
    "current_milestone": "{version}"
  },
  "allowed_transitions": [
    "patch",
    "minor",
    "major",
    "prerelease",
    "explicit"
  ],
  "gate": {
    "argv": [
      "./scripts/litai-service.sh",
      "test",
      "components/tracker",
      "--target",
      "host"
    ],
    "timeout_seconds": 86400
  },
  "changelog": {
    "path": "CHANGELOG.md",
    "unreleased_heading": "## Unreleased"
  },
  "tag": {
    "prefix": "v",
    "signed": false
  },
  "remote": "origin",
  "provider": {
    "kind": "github",
    "repository": "jordanhubbard/project-tracker"
  }
}
